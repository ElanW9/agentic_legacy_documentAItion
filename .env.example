# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM API settings ---
# API key for the LLM provider used by future pipeline scripts.
LLM_API_KEY=your-api-key-here
# Model identifier used for documentation drafting.
LLM_MODEL=claude-opus-5-5
# Optional base URL override for the LLM API (leave empty for the provider default).
LLM_BASE_URL=

# --- Project paths ---
# Root folder of the legacy PL/SQL source to document (relative to the repo root).
LEGACY_CODE_DIR=legacy_code
# Output folder for extracted metadata JSON.
METADATA_DIR=metadata

# --- Optional database settings (future use only; no DB access in this PoC) ---
# Database user for data dictionary / PL/Scope extraction.
DB_USER=
# Database password (never commit a real value).
DB_PASSWORD=
# Database connect string, e.g. host:port/service_name.
DB_DSN=
